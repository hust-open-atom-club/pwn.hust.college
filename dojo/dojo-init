#!/bin/sh

DOJO_DIR=/opt/pwn.college

>> $DOJO_DIR/data/config.env

> $DOJO_DIR/data/.config.env
define () {
    name="$1"
    default="$2"
    re="^${name}=\K.*"
    current="$(env | grep -oP ${re})"
    defined="$(grep -oP ${re} $DOJO_DIR/data/config.env)"
    value="${current:-${defined:-$default}}"
    echo "${name}=${value}" >> $DOJO_DIR/data/.config.env
}
define DOJO_HOST localhost.pwn.hust.college
define DOJO_ENV development
define DOJO_CHALLENGE challenge-mini
define SECRET_KEY $(openssl rand -hex 16)
define DOCKER_PSLR $(openssl rand -hex 16)
define UBUNTU_VERSION 22.04
define INTERNET_FOR_ALL False
define ARCH $(dpkg --print-architecture)
# Database credentials: fresh deployments get random passwords; deployments
# upgrading from the hardcoded-credential era keep the historical value so the
# existing mysql volume still authenticates (rotation steps in docs/deployment.md)
MYSQL_PASSWORD_DEFAULT=ctfd
MYSQL_ROOT_PASSWORD_DEFAULT=ctfd
if [ ! -d $DOJO_DIR/data/mysql/mysql ]; then
    MYSQL_PASSWORD_DEFAULT=$(openssl rand -hex 24)
    MYSQL_ROOT_PASSWORD_DEFAULT=$(openssl rand -hex 24)
fi
define MYSQL_PASSWORD $MYSQL_PASSWORD_DEFAULT
define MYSQL_ROOT_PASSWORD $MYSQL_ROOT_PASSWORD_DEFAULT
define MYSQL_USER ctfd
define MYSQL_DATABASE ctfd
define INSTALL_AFL no # needs compilation
define INSTALL_ANGR_MANAGEMENT no
define INSTALL_BURPSUITE no
define INSTALL_BUSYBOX no # needs compilation
define INSTALL_CAPSTONE no
define DEFAULT_INSTALL_SELECTION no # default to not installing tools
define INSTALL_DESKTOP yes # matches the challenge-mini configuration
define INSTALL_IDA_FREE no # explicitly disable -- only for free dojos
define INSTALL_BINJA_FREE no # explicitly disable -- only for free dojos
define KOOK_TOKEN
define KOOK_GUILD_ID
define KOOK_CLIENT_ID
define KOOK_CLIENT_SECRET
define KOOK_APP_ID
define KOOK_CHANNEL_ID_AWARD
define KOOK_CHANNEL_ID_WELCOME
define KOOK_CHANNEL_ID_NOTIFICATION

# The same value feeds MariaDB and the CTFd DATABASE_URL; restrict it to
# RFC 3986 unreserved characters so the URL never needs percent-encoding
for credential in MYSQL_PASSWORD MYSQL_ROOT_PASSWORD; do
    credential_value="$(grep -oP "^${credential}=\K.*" $DOJO_DIR/data/.config.env)"
    if ! echo "$credential_value" | grep -qP '^[A-Za-z0-9._~-]+$'; then
        echo "[-] ${credential} must only contain letters, digits, and . _ - ~ (it is embedded in DATABASE_URL verbatim)"
        exit 1
    fi
done

# Regenerate the mysqld-exporter credentials from the resolved config so the
# exporter keeps working across rotations (mounted via docker-compose.yml)
mkdir -p $DOJO_DIR/data/mysql-exporter
EXPORTER_PASSWORD="$(grep -oP '^MYSQL_ROOT_PASSWORD=\K.*' $DOJO_DIR/data/.config.env)"
printf '[client]\nuser=root\npassword=%s\n' "$EXPORTER_PASSWORD" > $DOJO_DIR/data/mysql-exporter/.my.cnf
chmod 600 $DOJO_DIR/data/mysql-exporter/.my.cnf

mv $DOJO_DIR/data/.config.env $DOJO_DIR/data/config.env
. $DOJO_DIR/data/config.env

if [ ! -f $DOJO_DIR/data/homes/homefs ]; then
    echo "[+] Creating user home structure."
    mkdir -p $DOJO_DIR/data/homes
    mkdir -p $DOJO_DIR/data/homes/data
    mkdir -p $DOJO_DIR/data/homes/nosuid
    dd if=/dev/zero of=$DOJO_DIR/data/homes/homefs bs=1M count=0 seek=1000
    mkfs.ext4 -O ^has_journal $DOJO_DIR/data/homes/homefs
    mount $DOJO_DIR/data/homes/homefs -o X-mount.mkdir $DOJO_DIR/data/homes/homefs_mount
    rm -rf $DOJO_DIR/data/homes/homefs_mount/lost+found/
    cp -a /etc/skel/. $DOJO_DIR/data/homes/homefs_mount
    chown -R 1000:1000 $DOJO_DIR/data/homes/homefs_mount
    umount $DOJO_DIR/data/homes/homefs_mount
    rm -rf $DOJO_DIR/data/homes/homefs_mount
fi

echo "[+] Creating loopback devices for home mounts. This might take a while."
for i in $(seq 1 4096); do
    if [ -e /dev/loop$i ]; then
        continue
    fi
    mknod /dev/loop$i b 7 $i
    chown --reference=/dev/loop0 /dev/loop$i
    chmod --reference=/dev/loop0 /dev/loop$i
done

if [ ! -d $DOJO_DIR/data/ssh_host_keys ]; then
    mkdir -p $DOJO_DIR/data/ssh_host_keys
    rm /etc/ssh/ssh_host_*_key*
    ssh-keygen -A -m PEM
    for key in $(ls /etc/ssh/ssh_host_*_key*); do
        cp -a $key $DOJO_DIR/data/ssh_host_keys
    done
fi
ssh-keyscan github.com > $DOJO_DIR/data/ssh_host_keys/ssh_known_hosts
for file in $(ls $DOJO_DIR/data/ssh_host_keys/*); do
    cp -a $file /etc/ssh
done

sysctl -w kernel.pty.max=1048576
echo core > /proc/sys/kernel/core_pattern

# East-west filtering on user_network only takes effect when bridged IPv4
# frames traverse iptables; without this sysctl the rules below silently
# match nothing while the platform appears fully functional.
modprobe br_netfilter 2>/dev/null || true
if [ "$(sysctl -n net.bridge.bridge-nf-call-iptables 2>/dev/null)" != "1" ]; then
    sysctl -w net.bridge.bridge-nf-call-iptables=1 2>/dev/null
    if [ "$(sysctl -n net.bridge.bridge-nf-call-iptables 2>/dev/null)" != "1" ]; then
        echo "ERROR: net.bridge.bridge-nf-call-iptables could not be enabled; user_network isolation would be ineffective. Aborting." >&2
        exit 1
    fi
fi

# dojo-init is documented as safe to rerun (docs/AGENTS.md), so every insert
# is guarded against stacking duplicate rules on rerun.
ensure_docker_user_rule() {
    iptables -C DOCKER-USER "$@" 2>/dev/null || iptables -I DOCKER-USER "$@"
}

iptables -N DOCKER-USER 2>/dev/null || true

# Remove monitoring allow rules from earlier versions: student containers must
# not reach Grafana/Prometheus directly (issue #206); admins use the loopback
# host ports (PR #202) or the nginx reverse proxy instead.
delete_docker_user_rule() {
    # older dojo-init runs may have inserted the same rule many times
    while iptables -C DOCKER-USER "$@" 2>/dev/null; do
        iptables -D DOCKER-USER "$@"
    done
}
delete_docker_user_rule -i user_network -p tcp --dport 3000 -j ACCEPT
delete_docker_user_rule -i user_network -p tcp --dport 9090 -j ACCEPT
delete_docker_user_rule -o user_network -p tcp --sport 3000 -j ACCEPT
delete_docker_user_rule -o user_network -p tcp --sport 9090 -j ACCEPT

ensure_docker_user_rule -i user_network -j DROP
for host in $(cat $DOJO_DIR/user_firewall.allowed); do
    # `host` prints CNAME chains before A records, so the first line's last
    # field is not necessarily an address; pull the first IPv4 from the output
    address="$(host "$host" 2>/dev/null | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n 1)"
    case "$address" in
        ""|*[!0-9.]*) echo "WARNING: allowlisted host '$host' did not resolve to an IPv4 address, skipping" >&2 ;;
        *) ensure_docker_user_rule -i user_network -d "$address" -j ACCEPT ;;
    esac
done
ensure_docker_user_rule -i user_network -s 10.114.0.0/24 -m conntrack --ctstate NEW -j ACCEPT
ensure_docker_user_rule -i user_network -s 10.114.0.0/24 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
ensure_docker_user_rule -i user_network -d 10.114.0.0/16 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT